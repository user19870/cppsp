import iostream
function complement(int x) int{
  
    return -x
}
function f(int x=2) float{
    print(complement(12345)," ")
    return 1 
}
function g() {
    f(3)
}
function test(int a,int b,int c) {
    return a+b+c
    }
function countdown(int n) {
  if (n > 0) {
    print(n," ")
    countdown(n - 1);
  }
}

function m() 
var a,b,tmp ={1,2,3},{4,5,test(1,2,9)},complement(10) int
 
g() g() a() countdown(10)  //a() will be ignored
