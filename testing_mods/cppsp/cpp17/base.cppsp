@custom vec@mn("std::vector<",<{type}>,">")
 
 @inject(" template<typename T>
 using  vector =std::vector<T>
 //struct  vector {
 //function [push_back,size,at]
 //}
 ")
 
  
@custom vec("std::vector<",<{type}>,">")

 ////////vector操作//////////
use cppsp.base
 function  len(vec(int) v) int{   return  v..size();}
  function  len(vec(float) v) int{   return  v..size();}
   function  len(vec(char) v) int{   return  v..size();}
    function  len(vec(bool) v) int{   return  v..size();}
     function  len(vec(string) v) int{   return  v..size();}
 @custom mn_push_create("auto mn_push= [](auto &p,const ",<{t}>," &v){ p.push_back(v);};") //skip
 function [mn_push]
 mn_push_create(auto)
 