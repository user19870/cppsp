//////////字串///////////////
function[size,find,replace,empty,substr]//skip

 

function  len(const string& s) int{
    var i=0 int 
    for(unsigned char c:s){
        if((c & 0xC0) != 0x80){i++}    // abc and 11000... 當abc是10開頭才會等於100000...(0x80)，其他分別是00、01、11
        }
    return  i
}
function u8slice(const string& s,int start,int length=-1) string{
    if(start<0){start+= len(s)}
    var i,bytelen,s_pos,start_pos = <{-1}>,0,<{start+length-1}>,0 int
    if(s..empty()){return ""}
    for(unsigned char c:s){
        if((c & 0xC0) != 0x80){i++}
        if(i<start){start_pos++}
        if(i>=start&&i<=s_pos){bytelen++}    // abc and 11000... 當abc是10開頭才會等於100000...(0x80)，其他分別是00、01、11
        }
        if(length==-1){bytelen=s..size()-start_pos;}
    return  s..substr(start_pos,bytelen)
}
function u8replace(string &s,int start,int length,const string& newValue) {
    if(start<0){start+= len(s)}
    var i,bytelen,s_pos,start_pos = <{-1}>,0,<{start+length-1}>,0 int
     
    if(s..empty()){return 
    }
    for(unsigned char c:s){
        if((c & 0xC0) != 0x80){i++}
        if(i<start){start_pos++}
        if(i>=start&&i<=s_pos){bytelen++}    // abc and 11000... 當abc是10開頭才會等於100000...(0x80)，其他分別是00、01、11
        }
       
     s..replace(start_pos,bytelen,newValue)
}
function u8replace(string &s,const string& oldstr,const string& newstr,int max=-1) {
    
size_t pos=s..find(oldstr)

while(pos!=std::string::npos&&max!=0){
    s..replace(pos,oldstr..size(),newstr)
    if(max!=-1)max--
    pos=s..find(oldstr,pos+newstr..size())
}
}
function u8find(string &s,const string& target,int pos=0,int posend=-1)int{
  posend=posend-pos
    for(int i=0;i<len(s),posend!=0;i++){
        if(i>pos)posend--
        if(u8slice(s,i,len(target))==""){ return -1 
            }
        if(i>=pos&&u8slice(s,i,len(target))==target){<{return i}>
        }
    }
    return -1;  
}

function u8split(string& s,const string& sepa)std::vector[std::string]{
std::vector[std::string] res ={}
 var lastpos,latestpos=0,<{-1}> size_t
 var stmp string
 while((latestpos=u8find(s,sepa,lastpos))!=-1){
     res..push_back(u8slice(s,lastpos,latestpos-lastpos))
    lastpos=latestpos+len(sepa)
 }
 res..push_back(u8slice(s,lastpos))
return res
}

